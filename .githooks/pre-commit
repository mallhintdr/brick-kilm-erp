#!/bin/sh
# Every commit is an app update: bump the patch version (1.2.1 -> 1.2.2) and include it.
# Skip once with:  SKIP_VERSION_BUMP=1 git commit ...
[ "$SKIP_VERSION_BUMP" = "1" ] && exit 0
v=$(node scripts/bump-version.mjs) || exit 1
git add package.json package-lock.json
echo "app version -> $v"
